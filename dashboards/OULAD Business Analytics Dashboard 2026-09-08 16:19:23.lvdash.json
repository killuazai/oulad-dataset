{
  "datasets": [
    {
      "name": "genie_risk_summary",
      "displayName": "Risk Summary",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.genie_risk_summary",
        "dimensions": [
          {
            "name": "code_module",
            "expr": "code_module"
          },
          {
            "name": "code_presentation",
            "expr": "code_presentation"
          },
          {
            "name": "module_presentation",
            "expr": "CONCAT(code_module, ' - ', code_presentation)"
          },
          {
            "name": "risk_level",
            "expr": "risk_level"
          },
          {
            "name": "risk_level_order",
            "expr": "risk_level_order"
          }
        ],
        "measures": [
          {
            "name": "student_enrollments",
            "expr": "SUM(student_enrollments)"
          },
          {
            "name": "withdrawn_students",
            "expr": "SUM(withdrawn_students)"
          },
          {
            "name": "observed_withdrawal_rate_pct",
            "expr": "100 * SUM(withdrawn_students) / NULLIF(SUM(student_enrollments), 0)"
          }
        ]
      }
    },
    {
      "name": "genie_engagement_outcomes",
      "displayName": "Engagement Outcomes",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.genie_engagement_outcomes",
        "dimensions": [
          {
            "name": "final_result",
            "expr": "final_result"
          }
        ],
        "measures": [
          {
            "name": "student_enrollments",
            "expr": "SUM(student_enrollments)"
          },
          {
            "name": "average_active_days",
            "expr": "SUM(average_active_days * student_enrollments) / NULLIF(SUM(student_enrollments), 0)"
          },
          {
            "name": "average_total_clicks",
            "expr": "SUM(average_total_clicks * student_enrollments) / NULLIF(SUM(student_enrollments), 0)"
          },
          {
            "name": "median_total_clicks",
            "expr": "SUM(median_total_clicks * student_enrollments) / NULLIF(SUM(student_enrollments), 0)"
          }
        ]
      }
    },
    {
      "name": "genie_demographic_outcomes",
      "displayName": "Demographic Outcomes",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.genie_demographic_outcomes",
        "dimensions": [
          {
            "name": "gender",
            "expr": "gender"
          },
          {
            "name": "age_band",
            "expr": "age_band"
          },
          {
            "name": "highest_education",
            "expr": "highest_education"
          },
          {
            "name": "imd_band",
            "expr": "imd_band"
          }
        ],
        "measures": [
          {
            "name": "student_enrollments",
            "expr": "SUM(student_enrollments)"
          },
          {
            "name": "withdrawn_students",
            "expr": "SUM(withdrawn_students)"
          },
          {
            "name": "withdrawal_rate_pct",
            "expr": "100 * SUM(withdrawn_students) / NULLIF(SUM(student_enrollments), 0)"
          }
        ]
      }
    },
    {
      "name": "learner_outcomes",
      "displayName": "Learner Outcomes",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.learner_outcomes",
        "dimensions": [
          {
            "name": "code_module",
            "expr": "code_module"
          },
          {
            "name": "code_presentation",
            "expr": "code_presentation"
          },
          {
            "name": "module_presentation",
            "expr": "CONCAT(code_module, ' - ', code_presentation)"
          }
        ],
        "measures": [
          {
            "name": "enrolled_students",
            "expr": "SUM(enrolled_students)"
          },
          {
            "name": "withdrawn_students",
            "expr": "SUM(withdrawn_students)"
          },
          {
            "name": "failed_students",
            "expr": "SUM(failed_students)"
          },
          {
            "name": "passed_students",
            "expr": "SUM(passed_students)"
          },
          {
            "name": "distinction_students",
            "expr": "SUM(distinction_students)"
          },
          {
            "name": "successful_students",
            "expr": "SUM(passed_students + distinction_students)"
          },
          {
            "name": "successful_outcome_rate_pct",
            "expr": "100 * SUM(passed_students + distinction_students) / NULLIF(SUM(enrolled_students), 0)"
          },
          {
            "name": "withdrawal_rate_pct",
            "expr": "100 * SUM(withdrawn_students) / NULLIF(SUM(enrolled_students), 0)"
          }
        ]
      }
    },
    {
      "name": "genie_weekly_activity",
      "displayName": "Weekly Activity",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.genie_weekly_activity",
        "dimensions": [
          {
            "name": "code_module",
            "expr": "code_module"
          },
          {
            "name": "code_presentation",
            "expr": "code_presentation"
          },
          {
            "name": "relative_week",
            "expr": "relative_week"
          }
        ],
        "measures": [
          {
            "name": "total_clicks",
            "expr": "SUM(total_clicks)"
          },
          {
            "name": "active_students",
            "expr": "SUM(active_students)"
          }
        ]
      }
    },
    {
      "name": "assessment_performance",
      "displayName": "Assessment Performance",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`04-analytics`.assessment_performance",
        "dimensions": [
          {
            "name": "code_module",
            "expr": "code_module"
          },
          {
            "name": "code_presentation",
            "expr": "code_presentation"
          },
          {
            "name": "assessment_type",
            "expr": "assessment_type"
          }
        ],
        "measures": [
          {
            "name": "submission_count",
            "expr": "SUM(submission_count)"
          },
          {
            "name": "submitting_students",
            "expr": "SUM(submitting_students)"
          },
          {
            "name": "missing_score_count",
            "expr": "SUM(missing_score_count)"
          },
          {
            "name": "scored_submissions",
            "expr": "SUM(submission_count - missing_score_count)"
          },
          {
            "name": "weighted_average_score",
            "expr": "SUM(average_score * (submission_count - missing_score_count)) / NULLIF(SUM(submission_count - missing_score_count), 0)"
          },
          {
            "name": "median_score",
            "expr": "SUM(median_score * submission_count) / NULLIF(SUM(submission_count), 0)"
          },
          {
            "name": "pass_rate_pct",
            "expr": "100 * SUM(pass_rate * submission_count) / NULLIF(SUM(submission_count), 0)"
          },
          {
            "name": "late_submission_rate_pct",
            "expr": "100 * SUM(late_submission_rate * submission_count) / NULLIF(SUM(submission_count), 0)"
          }
        ]
      }
    }
  ],
